<% available_documents = Current.account.documents.where.not(id: chat.document_ids) %>
<% selected_documents = chat.documents %>

<% if available_documents.any? || selected_documents.any? %>
  <div class="mt-3">
    <details class="group">
      <summary class="cursor-pointer list-none flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Documents (<span id="document-selected-count"><%= chat.documents.count %></span> selected)</span>
        <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </summary>

      <div class="mt-2 space-y-3" data-controller="document-selection">
        <% if selected_documents.any? %>
          <div class="space-y-2">
            <div class="text-[10px] font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">Selected Documents</div>
            <% selected_documents.each do |document| %>
              <div class="flex items-center gap-2 rounded-lg border border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20 p-2">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-xs text-neutral-900 dark:text-neutral-100 truncate">
                    <%= document.title || document.file.filename %>
                  </div>
                  <% if document.file.attached? %>
                    <div class="text-[10px] text-neutral-500 dark:text-neutral-400 mt-0.5">
                      <%= number_to_human_size(document.file.byte_size) %>
                    </div>
                  <% end %>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-medium text-green-800 dark:bg-green-900/30 dark:text-green-400 flex-shrink-0">
                  <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Active
                </span>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if available_documents.any? %>
          <div class="space-y-2">
            <% if selected_documents.any? %>
              <div class="text-[10px] font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">Available Documents</div>
            <% end %>
            <div class="grid grid-cols-1 gap-2">
              <% available_documents.each do |document| %>
                <label class="flex items-center gap-2 rounded-lg border border-neutral-200 dark:border-neutral-700 p-2 cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-900/50 transition-colors">
                  <input
                    type="checkbox"
                    name="document_ids[]"
                    value="<%= document.id %>"
                    data-action="change->document-selection#updateCount"
                    class="w-3.5 h-3.5 rounded border-neutral-300 text-blue-600 focus:ring-blue-500 dark:border-neutral-600 dark:bg-neutral-800">
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-xs text-neutral-900 dark:text-neutral-100 truncate">
                      <%= document.title || document.file.filename %>
                    </div>
                    <% if document.file.attached? %>
                      <div class="text-[10px] text-neutral-500 dark:text-neutral-400 mt-0.5">
                        <%= number_to_human_size(document.file.byte_size) %> · 
                        <%= time_ago_in_words(document.created_at) %> ago
                      </div>
                    <% end %>
                  </div>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </details>
  </div>
<% end %>
